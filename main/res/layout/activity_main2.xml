<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/skin"
    tools:context=".MainActivity2">

    <!-- User Email Display -->
    <TextView
        android:id="@+id/user_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User Email: "
        android:textSize="18sp"
        android:backgroundTint="@color/skin2"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/custom_editor1"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="12dp" />

    <!-- Container Box for Slots and Remaining Balance -->
    <LinearLayout
        android:id="@+id/container_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/custom_editor1"
        android:padding="16dp"
        android:layout_marginTop="30dp"
        android:layout_below="@id/user_email"
        android:layout_marginBottom="12dp">

        <!-- Grid Layout for 6 Slots (3 Left, 3 Right) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginBottom="12dp">

            <!-- Slot 1 -->
            <TextView
                android:id="@+id/slot1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 1: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />

            <!-- Slot 2 -->
            <TextView
                android:id="@+id/slot2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 2: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />

            <!-- Slot 3 -->
            <TextView
                android:id="@+id/slot3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 3: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />

            <!-- Slot 4 -->
            <TextView
                android:id="@+id/slot4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 4: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />

            <!-- Slot 5 -->
            <TextView
                android:id="@+id/slot5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 5: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />

            <!-- Slot 6 -->
            <TextView
                android:id="@+id/slot6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Slot 6: fill"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:padding="10dp"
                android:background="@drawable/custom_editor1"
                android:layout_margin="8dp" />
        </GridLayout>

        <!-- Remaining Balance -->
        <TextView
            android:id="@+id/rembal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remaining Balance: 100"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:padding="10dp"
            android:textAlignment="center"
            android:background="@drawable/custom_editor1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/reservation_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservation Info"
            android:background="@drawable/custom_editor1"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:padding="10dp"
            android:textAlignment="center"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Reserve Slot Button -->
    <Button
        android:id="@+id/reserve_slot_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reserve a Slot"
        android:backgroundTint="@color/skin2"
        android:textColor="@android:color/white"
        android:layout_below="@id/container_box"
        android:layout_marginTop="10dp" />

    <!-- Manage Users Button -->
    <Button
        android:id="@+id/manage_users_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Users"
        android:backgroundTint="@color/skin2"
        android:textColor="@android:color/white"
        android:layout_below="@id/reserve_slot_btn"
        android:layout_marginTop="8dp" />

</RelativeLayout>
